# Lingbao LB-M8 (YXT LB-M8): b6a4:4000 = USB cable, b6a4:4001 = 2.4 GHz receiver
# Grants the locally logged-in user access to the mouse's HID interfaces,
# including the vendor config collection (report ID 6) on interface 2.
#
# IMPORTANT: the file MUST sort before 73-seat-late.rules, otherwise the
# uaccess tag arrives too late and no ACL is granted. Hence the 70- prefix.
#
# Install:
#   sudo install -m644 70-lingbao-lbm8.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger --action=add --subsystem-match=hidraw

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="b6a4", ATTRS{idProduct}=="400[01]", TAG+="uaccess", MODE="0660"
SUBSYSTEM=="usb",    ATTRS{idVendor}=="b6a4", ATTRS{idProduct}=="400[01]", TAG+="uaccess"
